aper"},"m":1,"f":15,"q":254,"av":"20260910012106","bv":"20260910005509"}],"2009-3":[{"i":"source-7dc257dc045ea3b46b61","d":{"updated":"2026-08-09T01:39:56+00:00","sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260809013956","bv":"20260815094151"}],"2009-4":[{"i":"source-78f85e8c9f811e3dadd0","d":{"updated":"2026-09-10T00:52:50+00:00","sourceKind":"article"},"m":1,"f":15,"q":203,"av":"20260910005250","bv":"20260910005255"}],"2009-5":[{"i":"source-d92ec57d6a0bc54cde63","d":{"title":"Microsoft IIS 0Day Vulnerability in Parsing Files (semi-colon bug)","updated":"2026-09-09T22:23:43+00:00","sourceKind":"paper"},"m":1,"f":15,"q":238,"av":"20260909222343","bv":"20260909222346"},{"label":"Microsoft advisory","url":"http://blogs.technet.com/msrc/archive/2009/12/27/new-reports-of-a-vulnerability-in-iis.aspx","i":"source-d36fb330b31662368847","d":{"title":"New Reports of a Vulnerability in IIS","publisher":"blogs.technet.com","kind":"article","language":"en","authors":["Jerry Bryant"],"summary":"MSRC's response to the IIS semicolon reports. Microsoft says the server must be in a non-default configuration to be affected, requiring an authenticated attacker with write access to a directory that also carries execute permission, and criticises the lack of coordinated disclosure. It lists IIS hardening guidance as interim mitigation.","tags":["vendor-advisory","file-upload","mitigation","aspnet","rce","defence"],"updated":"2026-08-17T08:30:37+00:00","sourceKind":"advisory"},"a":"archived-references/md/2009/blogs-technet-com-new-reports-vulnerability-iis.md","b":"archived-references/pdf/2009/blogs-technet-com-new-reports-vulnerability-iis.pdf","av":"20260817083037","bv":"20260817083138"}],"2009-6":[{"i":"source-683c743fd087926bbe5c","d":{"updated":"2026-09-10T00:52:58+00:00","sourceKind":"article"},"m":1,"f":15,"q":203,"av":"20260910005258","bv":"20260910005305"}],"2009-7":[{"i":"source-cfc6440817ab0cae508e","d":{"updated":"2026-09-10T00:53:07+00:00","sourceKind":"article"},"m":1,"f":15,"q":239,"av":"20260910005307","bv":"20260910005313"}],"2009-8":[{"i":"source-0d740732936a0d47762b","d":{"updated":"2026-09-10T00:55:53+00:00","sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260910005553","bv":"20260910005559"}],"2009-9":[{"label":"Persistent Cookies and DNS Rebinding Redux","i":"source-8794911eb596d2ff3547","d":{"title":"Persistent Cookies and DNS Rebinding Redux","updated":"2026-09-10T00:53:14+00:00","sourceKind":"article"},"m":1,"f":14,"q":202,"av":"20260910005314","bv":"20260910005320"},{"label":"DNS Rebinding for Scraping and Spamming","url":"http://ha.ckers.org/blog/20091118/dns-rebinding-for-scraping-and-spamming/","i":"source-2eb3af9341923c9c85d5","d":{"title":"DNS Rebinding for Scraping and Spamming","summary":"Third part of a DNS rebinding series: because search engines ignore the Host header and serve over plain HTTP, an attacker can rebind a domain and have visitors' own browsers scrape Google, defeating CAPTCHAs and IP blocking. The same IP diversity supports comment spamming, poll fraud and brute force from other people's addresses.","tags":["dns","dns-rebinding","sop-bypass","javascript","https","tls","owasp-a01-2021","owasp-a02-2021","owasp-a10-2021"],"updated":"2026-09-10T00:53:22+00:00","relationship":"related","sourceKind":"article"},"q":10,"a":"archived-references/md/2009/ha-ckers-org-dns-rebinding-scraping-spamming.md","b":"archived-references/pdf/2009/ha-ckers-org-dns-rebinding-scraping-spamming.pdf","av":"20260910005322","bv":"20260910005328"},{"label":"Session Fixation Via DNS Rebinding","url":"http://ha.ckers.org/blog/20091116/session-fixation-via-dns-rebinding/","i":"source-14c89a46396ff6e818ff","d":{"title":"Session Fixation Via DNS Rebinding","summary":"An attacker logs into goodguy.com, replays his own cookies from badguy.com, and serves badguy.com DNS with a one-second TTL before dropping its firewall. The browser rebinds badguy.com to goodguy.com's address, and because the site ignores the Host header the attacker's cookies apply, placing the victim inside the attacker's account. Respecting the Host header is the proposed defence.","tags":["dns-rebinding","dns","session-fixation","cookie","http","same-origin-policy","owasp-a01-2021","owasp-a07-2021","owasp-a10-2021"],"updated":"2026-09-10T00:53:31+00:00","relationship":"related","sourceKind":"article"},"q":10,"a":"archived-references/md/2009/ha-ckers-org-session-fixation-dns-rebinding.md","b":"archived-references/pdf/2009/ha-ckers-org-session-fixation-dns-rebinding.pdf","av":"20260910005331","bv":"20260910005337"},{"label":"Author’s follow-up explanation","url":"http://ha.ckers.org/blog/20091201/dns-rebinding-video/","i":"source-26c4bf3a605c810352e6","d":{"title":"DNS Rebinding Video","relationship":"follow-up","sourceKind":"video","preservation":"link-only","context":"The November session-fixation article comment dated December 1 links this video as the author's explanation answering a reader's confusion. It is a later explanation in the cookie/DNS-rebinding research line, not a conference recording of either article."},"a":"","b":""}],"2009-10":[{"i":"source-98b565dc3ada6c6baf49","d":{"title":"iPhone SSL Warning and Safari Phishing ha.ckers.org web application security lab","updated":"2026-08-09T10:08:46+00:00","sourceKind":"article"},"m":1,"f":15,"q":202,"av":"20260809100846","bv":"20260815094120"}],"2009-11":[{"i":"source-3168a6bb4a92e3c33390","d":{"title":"RFC1918 Blues ha.ckers.org web application security lab","updated":"2026-08-09T10:08:47+00:00","sourceKind":"article"},"m":1,"f":15,"q":202,"av":"20260809100847","bv":"20260815094121"}],"2009-12":[{"i":"source-9279a9cb6a591047c17f","d":{"title":"CSRF And Ignoring Basic/Digest Auth ha.ckers.org web application security lab","updated":"2026-08-16T23:12:52+00:00","sourceKind":"article"},"m":1,"f":15,"q":202,"av":"20260816231252","bv":"20260816231612"}],"2009-13":[{"i":"source-55a2ba3a31f87b2e3da4","d":{"title":"Hash Information Disclosure Via Collisions - The Ha