Web Applications","authors":["Scott T. Stender","Alexander G. Vidergar"],"summary":"iSEC Partners on race conditions as a security class in web applications: frameworks favour throughput and encapsulation over synchronisation, so transfers, authorisation changes and one-time redemptions can be replayed mid-transaction. Gives white-box and black-box procedures, notes ASP.NET, Servlets and Struts 1.x/2.x differ on thread safety, and ships the SyncTest tool.","tags":["race-condition","toctou","java","aspnet","tooling","dynamic-analysis","database","defence","owasp-a04-2021"],"updated":"2026-08-12T16:00:22+00:00","relationship":"related","sourceKind":"paper"},"q":8,"a":"archived-references/md/2008/concurrency-attacks-web-applications.md","b":"archived-references/pdf/2008/concurrency-attacks-web-applications.pdf","av":"20260812160022","bv":"20260808235802"}],"2008-76":[{"i":"source-256ae23bd616ecce6eb4","d":{"updated":"2026-08-11T17:34:18+00:00","alsoAt":["https://coeus.ece.gatech.edu/articles/increased_dns_resistance.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":235,"av":"20260811173418","bv":"20260809132923"}],"2008-77":[{"i":"source-8fd11be69f472f9da1b7","d":{"updated":"2026-08-08T23:57:31+00:00","sourceKind":"article"},"m":1,"f":15,"q":235,"av":"20260808235731","bv":"20260815102036"}],"2008-78":[{"i":"source-7a374086a63cc824c454","d":{"title":"CookieMonster: Cookie Hijacking","updated":"2026-08-11T19:36:41+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260811193641","bv":"20260811193927"},{"label":"disclosure","url":"https://fscked.org/blog/fully-automated-active-https-cookie-hijacking","i":"source-80c047cf94bafd0f3d4e","d":{"title":"Automated HTTPS Cookie Hijacking","summary":"Mike Perry's DEFCON 16 disclosure of fully automated HTTPS session hijacking. A network attacker caches DNS answers to learn which host each client resolved before every port 443 connection, then injects image tags for those domains into the client's next plain HTTP page, forcing non-Secure cookies over cleartext and writing them to a Firefox cookie file.","tags":["https","cookie","tls","dns","tooling","info-leak","owasp-a02-2021","owasp-a07-2021"],"updated":"2026-08-11T19:36:40+00:00","relationship":"related","sourceKind":"article"},"q":58,"a":"archived-references/md/2008/fscked-org-automated-https-cookie-hijacking.md","b":"archived-references/pdf/2008/fscked-org-automated-https-cookie-hijacking.pdf","av":"20260811193640","bv":"20260815101946"},{"label":"Slides","url":"https://fscked.org/talks/ActiveHTTPSCookieStealing.pdf","i":"source-e8fda3a74a557836e26f","d":{"title":"365-Day: https Cookie Stealing","kind":"whitepaper","summary":"Session cookies set over HTTPS but lacking the Secure bit are handed out on any plaintext request. Inject an <img src=\"http://mail.google.com/mail\"> into any HTTP page the victim loads on a shared network and the gmail cookie arrives in the clear, days after they last logged in.","tags":["cookie","https","tls","auth-bypass","info-leak","tooling","owasp-a01-2021","owasp-a02-2021","owasp-a07-2021"],"updated":"2026-08-09T20:44:24+00:00","sourceKind":"slides"},"q":32,"a":"archived-references/md/2008/365-day-https-cookie-stealing.md","b":"archived-references/pdf/2008/365-day-https-cookie-stealing.pdf","av":"20260809204424","bv":"20260809204446"},{"label":"Researcher’s disclosure context","url":"https://fscked.org/blog/why-full-disclosure","i":"source-5fe2ef457d3914d0da7d","d":{"title":"Why Full Disclosure","sourceKind":"article","context":"A companion publication linked by the original source."},"q":8,"a":"","b":""},{"label":"Parallel implementation","url":"http://enablesecurity.com/2008/08/11/surf-jack-https-will-not-save-you/","i":"source-3baddcee28f2f2a97ed1","d":{"title":"Surf Jack: HTTPS Will Not Save You","relationship":"analysis","sourceKind":"article","context":"A related explanation or case study linked by the source."},"q":8,"a":"","b":""}],"2008-79":[{"i":"source-da410971cafb14184379","d":{"updated":"2026-08-11T17:46:31+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811174631","bv":"20260808235816"}],"2008-80":[{"i":"source-4435137360ec42717437","d":{"updated":"2026-09-10T14:01:40+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260910140140","bv":"20260910155722"}],"2008-81":[{"i":"source-d1cc0a600f7c947fe5cf","d":{"updated":"2026-09-13T23:01:45+00:00","sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260913230145","bv":"20260913230455"},{"label":"Login CSRF and Cookie-Integrity research","url":"http://www.adambarth.com/papers/2008/barth-jackson-mitchell-b.pdf","i":"source-28e4bb2524b5249c4c87","d":{"kind":"whitepaper","title":"Login CSRF and Cookie-Integrity research","relationship":"background","sourceKind":"paper","context":"Author recommends this paper for the login-CSRF implications and Cookie-Integrity mitigation discussed in the article."},"a":"","b":""}]}}
