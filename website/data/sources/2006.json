m":1,"f":15,"q":202,"av":"20260809102625","bv":"20260810113600"}],"2006-69":[{"i":"source-b3917f2de2ee6cc3c06b","d":{"title":"ha.ckers.org web application security lab","updated":"2026-08-09T10:08:36+00:00","sourceKind":"article"},"m":1,"f":15,"q":202,"av":"20260809100836","bv":"20260810112249"},{"label":"Part 1","url":"http://michaeldaw.org/md-hacks/csrf-with-msword/","i":"source-7466ddf949f7b8ef59f2","d":{"title":"CSRF with MS Word","publisher":"michaeldaw.org","language":"en-us","authors":["David Kierznowski"],"summary":"David Kierznowski turns Microsoft Word into a CSRF client by inserting a frame pointing at an attacker-controlled HTML page full of image tags. Word fetches it through Internet Explorer with no warning in Word 2000, so the requests fire every time the document is opened, and the attacker can retarget them later via 302 redirects or by editing the hosted page.","tags":["csrf","abuse-of-functionality","attack-chain","owasp-a01-2021","owasp-a04-2021"],"updated":"2026-08-07T18:12:16+00:00","relationship":"part","sourceKind":"article","context":"Another installment in the same research series.","sequence":1},"q":8,"a":"archived-references/md/2006/michaeldaw-org-csrf-ms-word.md","b":"archived-references/pdf/2006/michaeldaw-org-csrf-ms-word.pdf","av":"20260807181216","bv":"20260815114043"}],"2006-70":[{"i":"source-9bc668e1aed99cb9ea0e","d":{"updated":"2026-08-09T03:34:45+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260809033445","bv":"20260809124237"},{"label":"event page","url":"https://fahrplan.events.ccc.de/congress/2006/Fahrplan/events/1602.en.html","i":"source-a99b8fd4b9b71cb6930e","d":{"title":"23C3: Subverting AJAX","published":"2007-01-30","kind":"article","summary":"The 23C3 schedule entry for Di Paola and Fedon's lecture, carrying the abstract and a link to the whitepaper. It announces content and request hijacking in Ajax pages via JavaScript prototyping — hijacking functions and objects so attacks run transparently without breaking the page — plus cross-domain code injection and UXSS through browser plugins and sandbox flaws.","tags":["javascript","xss","dom","sop-bypass","prototype-pollution","injection","owasp-a01-2021","owasp-a03-2021","owasp-a08-2021"],"updated":"2026-08-11T17:40:01+00:00","relationship":"related","sourceKind":"article"},"q":34,"a":"archived-references/md/2006/2007-fahrplan-events-ccc-de-23c3-subverting-ajax.md","b":"archived-references/pdf/2006/2007-fahrplan-events-ccc-de-23c3-subverting-ajax.pdf","av":"20260811174001","bv":"20260811175055"}],"2006-71":[{"i":"source-2f2198a826f492cd2abd","d":{"updated":"2026-08-08T07:47:51+00:00","alsoAt":["https://seclists.org/fulldisclosure/2006/Jan/943"],"sourceKind":"code"},"m":1,"f":15,"q":233,"av":"20260808074751","bv":"20260811195925"},{"label":"mirror","url":"https://seclists.org/fulldisclosure/2006/Jan/943","i":"source-d0262bcf99f7d3bfafcf","d":{"title":"Full Disclosure: Cross Site Cooking","publisher":"seclists.org","kind":"article","language":"en","summary":"Michal Zalewski's Full Disclosure posting naming three cookie-domain flaws. Browsers accept two-period ccTLD cookies such as *.com.pl; trailing and empty periods let a cookie be set for '.com.' and relayed to victim.com.; and an attacker-controlled DNS A record makes visitors relay forged cookies to a third-party server, enabling session fixation and preference corruption.","tags":["cookie","session-fixation","auth-bypass","dns","url-parsing","parser-differential","owasp-a01-2021","owasp-a07-2021"],"updated":"2026-08-09T01:40:33+00:00","relationship":"related","sourceKind":"article"},"q":32,"a":"archived-references/md/2006/seclists-org-full-disclosure-cross-site-cooking.md","b":"archived-references/pdf/2006/seclists-org-full-disclosure-cross-site-cooking.pdf","av":"20260809014033","bv":"20260810113300"}],"2006-72":[{"i":"source-1b0c960630926e713a65","d":{"updated":"2026-08-09T03:35:16+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260809033516","bv":"20260809124231"}],"2006-73":[{"i":"source-751bcf7ef9a8932bfd32","d":{"updated":"2026-08-11T17:39:31+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811173931","bv":"20260808235802"}],"2006-74":[{"i":"source-7097a5d487a88b2dc7fb","d":{"updated":"2026-08-11T17:38:50+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811173850","bv":"20260808235801"}],"2006-75":[{"i":"source-0865f59b7854630d9642","d":{"updated":"2026-08-16T00:00:46+00:00","sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260816000046","bv":"20260811194005"}],"2006-76":[{"i":"source-c26b45fa33fef52ea857","d":{"title":"Bugtraq: Whitepaper by Amit Klein: \"HTTP Response Smuggling\"","updated":"2026-09-10T13:59:52+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260910135952","bv":"20260910155758"}],"2006-77":[{"i":"source-241a03a0ce0371aed49b","d":{"updated":"2026-09-13T23:01:45+00:00","sourceKind":"article"},"m":1,"f":15,"q":235,"av":"20260913230145","bv":"20260913230401"}]}}
