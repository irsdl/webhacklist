":"USENIX","minutes":23},"a":"","b":""}],"2014-52":[{"i":"source-977fcdf97bb2bb94d40f","d":{"updated":"2026-08-14T21:00:33+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260814210033","bv":"20260808235807"}],"2014-53":[{"i":"source-c388ceaae75cdb7552ef","d":{"updated":"2026-08-14T15:05:45+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity14/sec14-paper-silver.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150545","bv":"20260814150604"}],"2014-54":[{"i":"source-1b06b6b310f86742a64a","d":{"updated":"2026-08-14T21:00:36+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260814210036","bv":"20260808235807"}],"2014-55":[{"i":"source-9dd4311a158b14efabdd","d":{"updated":"2026-08-14T22:36:51+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260814223651","bv":"20260808235814"}],"2014-56":[{"i":"source-a4439ef14098c2f0c6f9","d":{"title":"MACE: Detecting privilege escalation vulnerabilities in web applications for CCS 2014","updated":"2026-08-08T23:55:04+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260808235504","bv":"20260815065042"}],"2014-57":[{"i":"source-5c73dd3e4ffa48fcce97","d":{"updated":"2026-08-14T15:05:45+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity14/sec14-paper-meyer.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150545","bv":"20260814150603"}],"2014-58":[{"i":"source-1688645b9704d744a368","d":{"title":"[1410.2087] A Web Traffic Analysis Attack Using Only Timing Information","updated":"2026-08-19T16:48:45+00:00","alsoAt":["https://arxiv.org/pdf/1410.2087"],"sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260819164845","bv":"20260819164847"}],"2014-59":[{"i":"source-03851707b87dcf4ae61b","d":{"updated":"2026-08-12T16:01:06+00:00","alsoAt":["https://www.ndss-symposium.org/wp-content/uploads/2017/09/04_2_1.pdf","https://www.ndss-symposium.org/wp-content/uploads/2017/09/04_2_slides.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260812160106","bv":"20260810091343"}],"2014-60":[{"i":"source-b187278cc712cbe51c86","d":{"updated":"2026-08-14T15:05:45+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity14/sec14-paper-zhou.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150545","bv":"20260814150607"}],"2014-61":[{"i":"source-f6250f82bdf63d2f1769","d":{"updated":"2026-08-11T17:43:30+00:00","alsoAt":["https://www.ndss-symposium.org/wp-content/uploads/2017/09/04_4_1.pdf","https://www.ndss-symposium.org/wp-content/uploads/2017/09/04_4_slides.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260811174330","bv":"20260810091343"}],"2014-62":[{"i":"source-b3a635afd4e47407aa24","d":{"updated":"2026-08-10T15:03:02+00:00","sourceKind":"article"},"m":1,"f":15,"q":235,"av":"20260810150302","bv":"20260812160906"},{"label":"Whitepaper","url":"https://www.blackhat.com/docs/eu-14/materials/eu-14-Hayak-Same-Origin-Method-Execution-Exploiting-A-Callback-For-Same-Origin-Policy-Bypass-wp.pdf","i":"source-c1b169099dab0b6cabf8","d":{"title":"eu 14 Hayak Same Origin Method Execution Exploiting A Callback For Same Origin Policy Bypass wp","kind":"whitepaper","summary":"Same Origin Method Execution abuses a page's own JSONP-style callback parameter: instead of a script name the attacker supplies a DOM path such as opener.document.forms[0].submit, and a chain of popups and redirects makes the trusted page call it. The victim's own origin executes the attacker's chosen method, defeating the same-origin policy without injecting script.","tags":["sop-bypass","same-origin-policy","open-redirect","dom","javascript","owasp-a01-2021","owasp-a04-2021"],"updated":"2026-08-14T22:36:34+00:00","sourceKind":"paper"},"q":32,"a":"archived-references/md/2014/eu-14-hayak-same-origin-method-execution-exploiting-callback-same-origin-wp.md","b":"archived-references/pdf/2014/eu-14-hayak-same-origin-method-execution-exploiting-callback-same-origin-wp.pdf","av":"20260814223634","bv":"20260807233717"},{"label":"Whitepaper","url":"http://files.benhayak.com/Same_Origin_Method_Execution__paper.pdf","i":"source-7aecd29951b5ecffdf08","d":{"kind":"whitepaper","title":"Same Origin Method Execution","sourceKind":"paper","context":"A companion paper linked by the original source."},"a":"","b":""},{"label":"Updated Black Hat slides","url":"https://www.slideshare.net/BenHayak/blackhat-eu-same-origin-method-execution","i":"source-df7218309cd1f6ba6346","d":{"kind":"slides","title":"Same Origin Method Execution","sourceKind":"slides","context":"A companion slide deck linked by the original source."},"a":"","b":""},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=UfYfID_r7-U","i":"source-855e21c6722ec9782f58","d":{"title":"Same Origin Method Execution (SOME) - Exploiting a Callback for Same Origin Policy Bypass","published":"2015-04-03","sourceKind":"video","preservation":"link-only","channel":"Black Hat","minutes":44},"a":"","b":""}],"2014-63":[{"i":"source-ed70a4665e3ad6cc81fa","d":{"updated":"2026-08-14T15:05:45+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity14/sec14-paper-wang-tao.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150545","bv":"20260814150605"}],"2014-64":[{"i":"source-3ec3ccf723dbf3cfbeab","d":{"title":"The Emperor’s New Password Manager: Security Analysis of Web-based Password Managers","updated":"2026-08-19T16:44:42+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity14/sec14-paper-li-zhiwei.pdf","https://www.usenix.org/sites/default/files/conference/protected-files/sec14_slides_li-zhiwei.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260819164442","bv":"20260819164443"},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=bn84zLm3nHQ","i":"source-d67a3a947c18ee20601c","d":{"title":"USENIX Security '14 - The Emperor’s New Password Manager: Security Analysis of Web-based Password","published":"2014-10-23","sourceKind":"video","preservation":"link-only","channel":"USENIX","minutes":20},"a":"","b":""}],"2014-65":[{"i":"source-b709238827c63013855b","d":{"updated":"2026-08-11T17:38:26+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811173826","bv":"20260808235801"},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=eLhb4jZuv6M","i":"source-095fe5dc725cbfa99736","d":{"published":"2015-04-03","sourceKind":"video","preservation":"link-only","channel":"Black Hat","minutes":46},"q":1,"a":"","b":""}],"2014-66":[{"i":"source-3615f31bb4c5a1bcd7fb","d":{"updated":"2026-09-10T14:50:27+00:00","sourceKind":"article"},"m":1,"f":15,"q":233,"av":"20260910145027","bv":"20260910155654"}],"2014-67":[{"i":"source-6d17fbf9f24c95e6dcb8","d":{"updated":"2026-09-11T20:35:56+00:00","sourceKind":"article"},"m":1,"f":15,"q":255,"av":"20260911203556","bv":"20260911205048"}],"2014-68":[{"i":"source-d9c0097deb555c599170","d":{"title":"SpoofedMe: Intruding Accounts using Social Login Providers","updated":"2026-09-13T23:01:45+00:00","sourceKind":"slides"},"m":1,"f":15,"q":238,"av":"20260913230145","bv":"20260913230510"},{"label":"Earlier account-linking analysis","url":"http://nat.sakimura.org/2012/04/27/comments-on-wang-chen-wang-paper/","i":"source-f9d0cdeb3a29a55202d7","d":{"kind":"article","title":"Comments on Wang-Chen-Wang paper on OpenID Implementation Vulnerability","relationship":"background","sourceKind":"article","context":"Earlier research cited as a basis for this technique."},"a":"","b":""}],"2014-69":[{"i":"source-227509f17fe70f5ef105","d":{"updated":"2026-09-15T10:36:14+00:00","sourceKind":"article"},"m":1,"f":15,"q":255,"av":"20260915103614","bv":"20260915104316"},{"label":"Author announcement","url":"https://lcamtuf.blogspot.com/2014/06/boolean-algebra-with-css-when-you-can.html","i":"source-66810f8f602c4c99d9c7","d":{"title":"Boolean algebra with CSS (when you can only set colors)","summary":"Announces research on constructing Boolean logic with CSS color properties under visited-link restrictions. Provides dated context for the longer technical article; its historical article link now returns a missing-page response.","tags":["css","browser-history"],"updated":"2026-09-15T10:27:02+00:00","sourceKind":"article","context":"The dated author announcement describes the same CSS color-only Boolean construction. Its original css_algebra link now returns 404; the current article is at css_calc."},"q":62,"a":"archived-references/md/2014/michal-zalewski-boolean-algebra-css-when-you-can-only-set-colors.md","b":"archived-references/pdf/2014/michal-zalewski-boolean-algebra-css-when-you-can-only-set-colors.pdf","av":"20260915102702","bv":"20260915102736"}],"2014-70":[{"i":"source-c1f96a70abd51facebb9","d":{"title":"Comma Separated Vulnerabilities","updated":"2026-09-16T13:43:43+00:00","sourceKind":"article"},"m":1,"f":15,"q":238,"av":"20260916134343","bv":"20260916135711"},{"label":"Vendor advisory","url":"https://seclists.org/bugtraq/2014/Aug/115","i":"source-7eb1a7f7a44db747ff68","d":{"title":"Bugtraq: CVE-2014-3524: Apache OpenOffice Calc Command Injection Vulnerability","publisher":"seclists.org","published":"2014-08-21","language":"en","authors":["Herbert Duerr"],"summary":"Apache's advisory describes command injection when affected Windows versions of OpenOffice Calc load crafted spreadsheets. It identifies the affected releases, recommends upgrading to 4.1.1, and credits Rohan Durve and James Kettle with discovering CVE-2014-3524.","tags":["command-injection","rce","owasp-a03-2021"],"updated":"2026-09-16T13:44:54+00:00","sourceKind":"advisory","context":"Vendor disclosure credits James Kettle and Rohan Durve for the spreadsheet issue discussed in the article."},"q":8,"a":"archived-references/md/2014/seclists-org-bugtraq-cve-2014-3524-apache-openoffice-calc-command-vulnerability.md","b":"archived-references/pdf/2014/seclists-org-bugtraq-cve-2014-3524-apache-openoffice-calc-command-vulnerability.pdf","av":"20260916134454","bv":"20260916135724"}],"2014-71":[{"i":"source-b3cd96b006fb8ed2e9af","d":{"title":"Tick Tock: Building Browser Red Pills from Timing Side Channels (Paper)","updated":"2026-09-29T21:07:09+00:00","sourceKind":"paper"},"m":1,"f":15,"q":238,"av":"20260929210709","bv":"20260929211717"},{"label":"Conference slides","url":"https://www.usenix.org/sites/default/files/conference/protected-files/woot14_slides_ho.pdf","i":"source-4109e1bc9f4153416404","d":{"title":"Tick Tock: Building Browser Red Pills from Timing Side Channels (Slides)","published":"2014","kind":"slides","summary":"The original conference slide deck presents the accompanying paper's mechanisms and experiments. Uses JavaScript timing ratios for DOM, storage, worker and graphics operations to distinguish tested virtual machines from physical hosts. A malicious site could withhold payloads from virtualized browser inspection without plugins or privileged instructions. The experiments cover two physical machines and a limited environment matrix, not a universal classifier.","updated":"2026-09-29T21:07:34+00:00","sourceKind":"slides","context":"Original slide deck accompanying the paper; separately credited from its cover."},"q":162,"a":"archived-references/md/2014/2014-usenix-tick-tock-building-browser-red-pills-timing-side-channels-slides.md","b":"archived-references/pdf/2014/2014-usenix-tick-tock-building-browser-red-pills-timing-side-channels-slides.pdf","av":"20260929210734","bv":"20260929211721"},{"label":"Conference recording","url":"https://www.youtube.com/watch?v=L5pWjFULhVQ","i":"source-7b8304da711afd2e221f","d":{"title":"Conference recording","sourceKind":"video","preservation":"link-only","context":"Linked by the original article, deck or conference organizer; retained as media, without claiming transcript review."},"a":"","b":""}]}}
