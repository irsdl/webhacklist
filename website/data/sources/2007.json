e505e2be78c485b9ea1","d":{"title":"Cyber Security Consulting Services","updated":"2026-08-09T02:39:41+00:00","sourceKind":"article"},"m":1,"f":15,"q":218,"av":"20260809023941","bv":"20260810113344"}],"2007-83":[{"i":"source-80587ebc62b700a10af5","d":{"title":"Boneh Publications: Exposing private information by timing web applications","updated":"2026-08-08T07:47:51+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260808074751","bv":"20260808074633"},{"label":"Paper","url":"https://archives.iw3c2.org/www2007/papers/paper555.pdf","i":"source-ad8ef64af52a1ce92cd6","d":{"title":"paper555","kind":"whitepaper","summary":"Bortz, Boneh and Nandy show web application response times leak private state. Direct timing exposes username validity and hidden gallery counts; cross-site timing uses img onerror from an attacker page to tell whether a victim is logged in and to count shopping-cart items. Ships mod_timepad as a defence.","tags":["timing-attack","side-channel","info-leak","xsleak","csrf","javascript","mitigation","owasp-a01-2021"],"updated":"2026-08-07T23:36:02+00:00","sourceKind":"paper"},"q":32,"a":"archived-references/md/2007/paper555.md","b":"archived-references/pdf/2007/paper555.pdf","av":"20260807233602","bv":"20260807233705"}],"2007-84":[{"i":"source-dccfa135777d7ffc27e6","d":{"updated":"2026-08-09T12:53:30+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260809125330","bv":"20260808235801"},{"label":"Slides","url":"https://www.blackhat.com/presentations/bh-europe-07/Sotirov/Presentation/bh-eu-07-sotirov-apr19.pdf","i":"source-722403ff1d9379e27ce3","d":{"title":"bh eu 07 sotirov apr19","summary":"Heap Feng Shui turns browser heap exploitation from a spray-and-pray into a deterministic technique. JScript string allocation and CollectGarbage give arbitrary-size alloc and free; the plunger sequence drains OLEAUT32's four cache bins so requests reach the system heap, then defragmentation, controlled FreeList placement and lookaside seeding put a fake vtable at a known address.","tags":["javascript","javascript-runtime","rce","tooling","mitigation"],"updated":"2026-08-09T05:36:34+00:00","sourceKind":"slides"},"q":40,"a":"archived-references/md/2007/bh-eu-07-sotirov-apr19.md","b":"archived-references/pdf/2007/bh-eu-07-sotirov-apr19.pdf","av":"20260809053634","bv":"20260809124231"}],"2007-85":[{"i":"source-2cde2a5cb1f62114d1f1","d":{"updated":"2026-08-09T03:36:09+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260809033609","bv":"20260809124300"},{"label":"Black Hat paper","url":"https://www.blackhat.com/presentations/bh-usa-07/Waissbein_Futoransky_and_Saura/Whitepaper/bh-usa-07-waissbein_futoransky_and_saura-WP.pdf","i":"source-ac1dc3ba431d8268f68d","d":{"title":"Black Hat paper","summary":"A timing attack that reads back a private, indexed database column using only INSERT permission on it. B-tree page splits in MySQL InnoDB take measurably longer, and a 90th-percentile threshold over recent insert times detects them; a base-b interval search then narrows to each key, an existing value announcing itself as a duplicate-key error.","tags":["timing-attack","side-channel","mysql","database","info-leak","mitigation"],"updated":"2026-08-09T03:35:25+00:00","sourceKind":"paper"},"q":40,"a":"archived-references/md/2007/black-hat-paper.md","b":"archived-references/pdf/2007/black-hat-paper.pdf","av":"20260809033525","bv":"20260809124232"}],"2007-86":[{"i":"source-06db6d8a67595620b461","d":{"title":"Frame Hijacking","updated":"2026-08-08T23:55:08+00:00","sourceKind":"article"},"m":1,"f":15,"q":234,"av":"20260808235508","bv":"20260815105843"},{"label":"WebKit disclosure","url":"https://bugs.webkit.org/show_bug.cgi?id=15936","i":"source-f40be4858a3c861771c0","d":{"title":"15936 – Overly permissive frame navigation allows password theft","publisher":"WebKit Bugzilla","published":"2007-11-10","language":"en","authors":["Adam Barth"],"summary":"WebKit allowed unrelated pages to navigate login frames and replace their contents while the trusted address bar stayed unchanged. This report and 16 comments trace browser comparisons, tests and fixes toward allowing navigation of top-level frames or frames whose target or ancestor shares the source origin. A later document.domain compatibility case is split into bug 16727.","tags":["iframe","same-origin-policy","sop-bypass","phishing","vendor-advisory","mitigation","owasp-a01-2021","owasp-a04-2021"],"updated":"2026-08-08T23:50:56+00:00","relationship":"related","sourceKind":"article"},"q":8,"a":"archived-references/md/2007/webkit-bugzilla-15936-overly-permissive-frame-navigation-allows-password-theft.md","b":"archived-references/pdf/2007/webkit-bugzilla-15936-overly-permissive-frame-navigation-allows-password-theft.pdf","av":"20260808235056","bv":"20260914093259"}],"2007-87":[{"i":"source-d754ac7d479fd2c546bc","d":{"title":"Secure Coding: JavaScript Hijacking","updated":"2026-08-08T23:55:10+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260808235510","bv":"20260815105844"},{"label":"Whitepaper","url":"https://img2.helpnetsecurity.com/dl/articles/JavaScript_Hijacking.pdf","i":"source-86f4ce2eb34074a9e075","d":{"kind":"whitepaper","authors":["Brian Chess","Yekaterina Tsipenyuk O'Neil","Jacob West"],"summary":"Chess, Tsipenyuk O'Neil and West show a script tag can pull a site's JSON responses cross-origin while the victim's cookies ride along, and redefining the Object or Array constructor captures the data. Of the 12 most popular AJAX frameworks only DWR 2.0 defends. Recommended: an unguessable request parameter plus a while(1); prefix.","tags":["javascript","sop-bypass","same-origin-policy","csrf","info-leak","cookie","measurement-study","mitigation","owasp-a01-2021","owasp-a07-2021"],"updated":"2026-08-11T17:35:38+00:00","sourceKind":"paper"},"q":1,"a":"archived-references/md/2007/javascript-hijacking.md","b":"archived-references/pdf/2007/javascript-hijacking.pdf","av":"20260811173538","bv":"20260808235808"}],"2007-88":[{"i":"source-2d95d5f28489821368b2","d":{"updated":"2026-08-14T15:05:45+00:00","alsoAt":["https://www.usenix.org/legacy/event/hotbots07/tech/full_papers/provos/provos.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150545","bv":"20260814150610"},{"label":"Paper","url":"https://www.usenix.org/legacy/event/hotbots07/tech/full_papers/provos/provos.pdf","i":"source-9268ae31dc37fc99642a","d":{"title":"provos","kind":"whitepaper","summary":"Google's twelve-month study behind Safe Browsing. MapReduce heuristics narrowed billions of crawled pages to 4.5 million, verified in instrumented IE virtual machines; 450,000 were confirmed drive-by-download vectors. Names four injection routes: server compromise, user content, ad sub-syndication and third-party widgets.","tags":["measurement-study","large-scale-scan","javascript","iframe","activex","supply-chain","detection","dynamic-analysis","owasp-a06-2021","owasp-a09-2021"],"updated":"2026-08-09T03:35:59+00:00","sourceKind":"paper"},"q":32,"a":"archived-references/md/2007/provos.md","b":"archived-references/pdf/2007/provos.pdf","av":"20260809033559","bv":"20260809124300"}],"2007-89":[{"i":"source-a5f727e837434441c086","d":{"updated":"2026-08-09T12:52:57+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260809125257","bv":"20260808235802"}],"2007-90":[{"i":"source-75bc17b7721ccfc047ae","d":{"title":"An Analysis of Browser Domain-Isolation Bugs and A Light-Weight Transparent Defense Mechanism","updated":"2026-08-11T17:36:03+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260811173603","bv":"20260811175141"},{"label":"Paper","url":"https://www.microsoft.com/en-us/research/wp-content/uploads/2016/02/ScriptAccenting.pdf","i":"source-8e78613ad8ea6436a495","d":{"title":"ScriptAccenting","kind":"whitepaper","summary":"Chen, Ross and Wang analyse four real IE frame-isolation bypasses: the file:javascript: relay through Windows Explorer, location.assign aliasing, ambiguous navigation initiators, and setCapture merging DOMs via event.srcElement. Their defence XORs scripts and object names with a per-origin accent key at the mshtml/jscript boundary, for 3.16% worst-case overhead.","tags":["same-origin-policy","sop-bypass","iframe","dom","javascript","mitigation","defence","owasp-a01-2021"],"updated":"2026-08-11T17:36:03+00:00","sourceKind":"paper"},"q":32,"a":"archived-references/md/2007/scriptaccenting.md","b":"archived-references/pdf/2007/scriptaccenting.pdf","av":"20260811173603","bv":"20260808235809"}],"2007-91":[{"i":"source-efd3a4952727a95e7235","d":{"updated":"2026-08-14T15:05:09+00:00","alsoAt":["https://www.usenix.org/legacy/event/hotsec07/tech/full_papers/jackson/jackson.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260814150509","bv":"20260814150611"},{"label":"Paper","url":"https://www.usenix.org/legacy/event/hotsec07/tech/full_papers/jackson/jackson.pdf","i":"source-cc39f7a1de8d8e2dc3b6","d":{"title":"jackson","kind":"whitepaper","summary":"Collin Jackson, Dan Boneh and John Mitchell name the Transaction Generator: malware that waits for the user to authenticate, then issues transactions from the user's own browser, cookie and IP, so stronger authentication and back-end risk analytics see nothing unusual. Defence must move from credentials to transaction integrity and confirmation, including in CardSpace and OpenID.","tags":["browser-extension","phishing","auth-bypass","cookie","openid","csrf","mitigation","owasp-a01-2021","owasp-a04-2021","owasp-a07-2021"],"updated":"2026-08-11T17:46:17+00:00","sourceKind":"paper"},"q":32,"a":"archived-references/md/2007/jackson.md","b":"archived-references/pdf/2007/jackson.pdf","av":"20260811174617","bv":"20260808235816"}],"2007-92":[{"i":"source-1ded17f8aec0294aab4b","d":{"title":"Full Disclosure: Advisory 03/2007: Multiple Browsers Cross Domain Charset Inheritance Vulnerability","updated":"2026-09-10T15:17:27+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260910151727","bv":"20260910160456"}],"2007-93":[{"i":"source-109c35e49967a2c30f21","d":{"updated":"2026-09-10T15:51:04+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260910155104","bv":"20260910155724"}],"2007-94":[{"i":"source-2df440f2b18132156890","d":{"updated":"2026-09-13T23:01:44+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260913230144","bv":"20260913230230"}],"2007-95":[{"i":"source-76db92dddf787810dfe3","d":{"updated":"2026-09-13T23:01:44+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260913230144","bv":"20260913230231"}]}}
