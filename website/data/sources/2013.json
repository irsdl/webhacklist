5,"q":233,"av":"20260812160032","bv":"20260808235808"}],"2013-49":[{"i":"source-0f939e4aec7a744ecaad","d":{"updated":"2026-08-17T10:07:05+00:00","alsoAt":["https://www.usenix.org/system/files/conference/woot13/woot13-dai.pdf","https://www.usenix.org/sites/default/files/conference/protected-files/dai_woot13_slides.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260817100705","bv":"20260817101132"}],"2013-50":[{"i":"source-23b1a317c7c4812d5c41","d":{"updated":"2026-08-11T17:44:17+00:00","alsoAt":["https://www.ndss-symposium.org/wp-content/uploads/2017/09/11_5.pdf","https://www.ndss-symposium.org/wp-content/uploads/2017/09/Presentation11_5.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260811174417","bv":"20260810091343"}],"2013-51":[{"i":"source-480c91fcde0b82e517e0","d":{"updated":"2026-09-10T15:17:13+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260910151713","bv":"20260910155742"}],"2013-52":[{"i":"source-53538f59948fdc8c858e","d":{"title":"Invisibility Purge (Slides)","updated":"2026-09-11T20:49:43+00:00","sourceKind":"slides"},"m":1,"f":15,"q":254,"av":"20260911204943","bv":"20260911205044"},{"label":".NET Havoc (Slides)","url":"https://storage.googleapis.com/google-code-archive-downloads/v2/code.google.com/hasc-research/DotNetHavoc%20-%2044Con2013.pptx","i":"source-40b084405263921da9f6","d":{"title":".NET Havoc — Manipulating Properties of Dormant Server Side Web Controls (Slides)","published":"2013-09-12","authors":["Shay Chen"],"summary":"ASP.NET control properties stored in ViewState expose another input surface. The slides demonstrate control fingerprinting, property overrides, dormant event execution, and reuse of cached state, distinguishing unsigned modifications from replay of valid signed values. SCIP automates parts of discovery and testing.","updated":"2026-09-11T20:36:01+00:00","alsoAt":["https://www.slideshare.net/slideshow/44con-2013-net-havoc-manipulating-properties-of-dormant-server-side-web-controls-shay-chen/29359614"],"sourceKind":"slides"},"q":154,"a":"archived-references/md/2013/hacktics-advanced-security-center-ernst-young-net-havoc-manipulating-slides.md","b":"archived-references/pdf/2013/hacktics-advanced-security-center-ernst-young-net-havoc-manipulating-slides.pdf","av":"20260911203601","bv":"20260911204745"}],"2013-53":[{"i":"source-832356b13793172bed69","d":{"title":"Illuminating the Security Issues Surrounding Lights-Out Server Management (Paper)","updated":"2026-09-29T21:09:44+00:00","sourceKind":"paper"},"m":1,"f":15,"q":238,"av":"20260929210944","bv":"20260929211243"},{"label":"Conference slides","url":"https://www.usenix.org/sites/default/files/conference/protected-files/bonkoski_woot13_slides.pdf","i":"source-643665742f27538ad7cf","d":{"title":"Illuminating the Security Issues with Lights-Out Server Management (Slides)","published":"2013","kind":"slides","authors":["Anthony J. Bonkoski","J. Alex Halderman"],"summary":"The original conference slide deck presents the accompanying paper's mechanisms and experiments. Demonstrates an unauthenticated stack overflow in a management-controller login CGI that yields root on the BMC. Firmware reuse, weak randomization and missing hardening broaden the concern beyond the tested device. Exposure measurements estimate affected systems; the authors did not exploit the Internet hosts they counted.","updated":"2026-09-29T21:07:42+00:00","sourceKind":"slides","context":"Original slide deck accompanying the paper; separately credited from its cover."},"q":130,"a":"archived-references/md/2013/2013-usenix-illuminating-security-issues-lights-out-server-management-slides.md","b":"archived-references/pdf/2013/2013-usenix-illuminating-security-issues-lights-out-server-management-slides.pdf","av":"20260929210742","bv":"20260929211331"}]}}
