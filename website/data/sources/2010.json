{"schema":1,"version":"9d1cdb37f079666199a7","year":"2010","items":{"2010-0":[{"i":"source-d303ec17a755545b9d04","d":{"title":"Practical Padding Oracle Attacks","updated":"2026-09-10T00:28:52+00:00","sourceKind":"paper"},"m":1,"f":15,"q":236,"av":"20260910002852","bv":"20260810131722"},{"label":"poet","url":"http://netifera.com/research/","i":"source-7f6be3034320d0527a60","d":{"title":"Flickr's API Signature Forgery Vulnerability","publisher":"Netifera","published":"2009-09-28","kind":"paper","language":"en","authors":["Thai Duong","Juliano Rizzo"],"summary":"Advisory MOCB-01 combines MD5 length extension with delimiter-free API parameter signing to forge requests for Flickr applications without their shared secret. It documents the attack, PHPFlickr redirect abuse, vendor responses, and HMAC-based remediation, while distinguishing application impersonation from user account compromise.","tags":["aspnet","dotnet","side-channel","tooling","auth-bypass","rest-api","owasp-a01-2021"],"updated":"2026-09-10T01:21:06+00:00","relationship":"related","sourceKind":"paper"},"a":"archived-references/md/2009/2009-netifera-flickr-s-api-signature-forgery-vulnerability.md","b":"archived-references/pdf/2009/2009-netifera-flickr-s-api-signature-forgery-vulnerability.pdf","av":"20260910012106","bv":"20260910005509"},{"label":"Padbuster","url":"http://www.gdssecurity.com/l/b/2010/09/14/automated-padding-oracle-attacks-with-padbuster/","i":"source-d311fd086b14dbde6589","d":{"title":"Automated Padding Oracle Attacks with PadBuster","publisher":"gdssecurity.com","published":"2010-09-14","kind":"article","language":"en","authors":["Brian Holyfield"],"summary":"Recovers CBC plaintext a byte at a time by brute-forcing an IV byte until the application stops reporting a padding error, then XORing the intermediary value out. PadBuster automates this, learns the error signature from the first 256 responses, and also forges arbitrary ciphertext block by block working backwards from the last.","tags":["tooling","side-channel","auth-bypass","http","perl","owasp-a01-2021"],"updated":"2026-09-10T01:11:29+00:00","relationship":"related","sourceKind":"article"},"a":"archived-references/md/2010/levelblue-com-automated-padding-oracle-attacks-padbuster.md","b":"archived-references/pdf/2010/levelblue-com-automated-padding-oracle-attacks-padbuster.pdf","av":"20260910011129","bv":"20260910011135"},{"label":"demo","url":"https://www.youtube.com/watch?v=yghiC_U2RaM","i":"source-158bbb8225f06e8511f2","d":{"title":"POET vs ASP.NET: DotNetNuke","publisher":"YouTube","published":"2010-09-16","kind":"video","authors":["cryptbe"],"relationship":"related","sourceKind":"video","preservation":"link-only"},"a":"","b":""}],"2010-1":[{"i":"source-7ce2b43a7d53e2714317","d":{"title":"samy kamkar - evercookie - virtually irrevocable persistent cookies","updated":"2026-09-10T00:57:58+00:00","sourceKind":"article"},"m":1,"f":15,"q":234,"av":"20260910005758","bv":"20260910005805"},{"label":"Research source","url":"https://github.com/samyk/evercookie","i":"source-514670b1c0f005d80b67","d":{"sourceKind":"code","preservation":"link-only","context":"A companion code artifact linked by the original source."},"q":1,"a":"","b":""},{"label":"Node.js implementation","url":"https://github.com/truongsinh/node-evercookie","i":"source-ec30144dd5c7445fc5c2","d":{"title":"Node Evercookie","relationship":"follow-up","sourceKind":"code","preservation":"link-only","context":"A follow-up that develops this research further."},"a":"","b":""},{"label":"Django implementation","url":"https://github.com/gdmka/django_evercookie","i":"source-8c454665202078041780","d":{"title":"Django Evercookie","relationship":"follow-up","sourceKind":"code","preservation":"link-only","context":"A follow-up that develops this research further."},"a":"","b":""}],"2010-2":[{"label":"Hacking Auto-Complete ","i":"source-9b8ec1019b9a578c6552","d":{"title":"Breaking Browsers: Hacking Auto-Complete (All Materials Available)","updated":"2026-08-10T15:30:15+00:00","sourceKind":"article"},"m":1,"f":14,"q":250,"av":"20260810153015","bv":"20260815085226"},{"label":"Safari","url":"https://jeremiahgrossman.blogspot.com/2010/07/i-know-who-your-name-where-you-work-and.html","i":"source-808e72c4be93ed0274d5","d":{"title":"I know who your name, where you work, and live (Safari v4 & v5)","publisher":"jeremiahgrossman.blogspot.com","published":"2010-07-21","summary":"Safari 4 and 5 filled form fields named name, company, city, state, country and email straight from the operating system address book, with data the user had never typed into any site. A page can create those fields invisibly, simulate A-Z keystrokes from JavaScript and read the visitor's real name, employer and email within seconds. Apple fixed it as CVE-2010-1796.","tags":["info-leak","javascript","dom","cve"],"updated":"2026-09-10T01:03:56+00:00","relationship":"related","sourceKind":"article"},"q":56,"a":"archived-references/md/2010/jeremiahgrossman-blogspot-com-i-know-who-your-name-where-you-work-live-v5.md","b":"archived-references/pdf/2010/jeremiahgrossman-blogspot-com-i-know-who-your-name-where-you-work-live-v5.pdf","av":"20260910010356","bv":"20260910010400"},{"label":"Safari v2 TabHack","url":"https://jeremiahgrossman.blogspot.com/2010/09/safari-autofill-hack-lives.html","i":"source-f0a42ec15b14d364c75f","d":{"title":"The Safari AutoFill hack LIVES!","summary":"Safari 5.0.1's patch for the AutoFill address-book leak was incomplete. An invisible form with fields named country, name, email and the rest is focused programmatically; the victim need only type the first character of their country and press TAB for Safari to fill every field from the operating system Me card, which script then reads. Two keystrokes replace the fully automatic original.","tags":["info-leak","prior-art-extension","javascript","dom","case-study","vendor-advisory"],"updated":"2026-08-10T15:30:16+00:00","relationship":"related","sourceKind":"article"},"q":58,"a":"archived-references/md/2010/blog-jeremiahgrossman-com-safari-autofill-hack-lives.md","b":"archived-references/pdf/2010/blog-jeremiahgrossman-com-safari-autofill-hack-lives.pdf","av":"20260810153016","bv":"20260815085227"},{"label":"Firefox","url":"https://jeremiahgrossman.blogspot.com/2010/07/in-firefox-we-cant-read-auto-complete.html","i":"source-02d87f0e58f66b2beaad","d":{"title":"In Firefox we can’t read auto-complete, but we can write to it (a lot)!","summary":"Firefox would not let a site read auto-complete data, so the author writes to it instead. A form posting into a hidden iframe, resubmitted every 2ms by setTimeout, floods the store with entries. Firefox keeps 200 characters per entry over 100 fields per form, enough to bury real entries such as email in junk or to fake a search the user never made. Safari and Chrome limit it.","tags":["javascript","iframe","dom","dos"],"updated":"2026-09-10T01:04:02+00:00","relationship":"related","sourceKind":"article"},"q":58,"a":"archived-references/md/2010/blog-jeremiahgrossman-com-firefox-we-cant-read-auto-complete-but-we-can-lot.md","b":"archived-references/pdf/2010/blog-jeremiahgrossman-com-firefox-we-cant-read-auto-complete-but-we-can-lot.pdf","av":"20260910010402","bv":"20260910010409"},{"label":"Internet Explorer","url":"https://jeremiahgrossman.blogspot.com/2010/07/stealing-autocomplete-form-data-in.html","i":"source-6163f9c7b91dfab638e6","d":{"title":"Stealing AutoComplete form data in Internet Explorer 6 & 7","summary":"Internet Explorer 6 and 7 share remembered form values across sites by input name, and the drop-down can be opened without user action. Firing synthetic down-arrow and enter keystrokes via fireEvent pulls the stored value into a field JavaScript can read, harvesting names, addresses and card numbers from dozens of field names in seconds.","tags":["info-leak","javascript","dom","case-study","cve"],"updated":"2026-08-10T15:30:14+00:00","relationship":"related","sourceKind":"article"},"q":58,"a":"archived-references/md/2010/blog-jeremiahgrossman-com-stealing-autocomplete-form-data-internet-explorer-6-7.md","b":"archived-references/pdf/2010/blog-jeremiahgrossman-com-stealing-autocomplete-form-data-internet-explorer-6-7.pdf","av":"20260810153014","bv":"20260815085224"},{"label":"Complete Black Hat slides","url":"http://www.slideshare.net/jeremiahgrossman/breaking-browsers-hacking-autocomplete-blackhat-usa-2010","i":"source-a2d846419ba4d6b74a1e","d":{"kind":"slides","title":"Breaking Browsers: Hacking Auto-Complete","sourceKind":"slides","context":"A companion slide deck linked by the original source."},"a":"","b":""},{"label":"Original demonstration","url":"http://ha.ckers.org/weird/safari_autofill.html","i":"source-e4d296491d185b0f2082","d":{"title":"Safari AutoFill disclosure demonstration","sourceKind":"code","preservation":"link-only","context":"A companion code artifact linked by the original source."},"a":"","b":""},{"label":"Follow-up demonstration","url":"http://ha.ckers.org/weird/safari_autofill2.html","i":"source-3df4e88d7a08e277c60e","d":{"title":"Safari AutoFill follow-up demonstration","relationship":"follow-up","sourceKind":"code","preservation":"link-only","context":"A follow-up that develops this research further."},"a":"","b":""},{"label":"Companion demonstration","url":"http://ha.ckers.org/weird/ie_autofill.html","i":"source-4785be661c4cf8c96864","d":{"title":"Internet Explorer AutoComplete disclosure","sourceKind":"code","preservation":"link-only","context":"A companion code artifact linked by the original source."},"a":"","b":""}],"2010-3":[{"i":"source-f6b50743ea077148b0b7","d":{"publisher":"YouTube","authors":["Elie Bursztein"],"sourceKind":"video","preservation":"link-only"},"m":1,"f":3,"q":13,"a":"","b":""},{"label":"Whitepaper","url":"https://media.blackhat.com/bh-us-10/whitepapers/Bursztein_Gourdin_Rydstedt/BlackHat-USA-2010-Bursztein-Bad-Memories-wp.pdf","i":"source-d4fb60bc1f4fd5a46154","d":{"title":"Bad Memories","kind":"whitepaper",