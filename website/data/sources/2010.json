5958","bv":"20260910155741"}],"2010-89":[{"i":"source-244a684bc671e46e22e9","d":{"updated":"2026-09-10T15:17:09+00:00","sourceKind":"paper"},"m":1,"f":15,"q":235,"av":"20260910151709","bv":"20260910155740"}],"2010-90":[{"originalMdPath":"archived-references/md/2010/xakep-ru-0day-cms.md","originalPdfPath":"archived-references/pdf/2010/xakep-ru-0day-cms.pdf","originalPdfVersion":"20260910155932","translated":true,"i":"source-0f30579ee2849486343b","d":{"title":"Молотком по Битриксу: Выявляем 0day-уязвимости популярной CMS","updated":"2026-09-10T15:59:28+00:00","sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260910155928","bv":"20260910155933"},{"label":"SDRF whitepaper","url":"https://seclists.org/fulldisclosure/2010/Aug/236","i":"source-4d5c39001bdb0587c035","d":{"title":"SDRF vulnerability in web-applications and browsers (Whitepaper)","publisher":"ONsec","published":"2010-08-18","kind":"whitepaper","language":"en","authors":["Vladimir Vorontsov"],"summary":"Uploaded PDF and Flash documents can inherit an application’s origin and browser credentials, read responses, extract anti-CSRF tokens, and submit authenticated requests. FormCalc demonstrates the chain in RoundCube. Opera 10.60/10.61 can retain the origin when opening a downloaded file, weakening download-header isolation.","tags":["csrf","file-upload","pdf","flash","sop-bypass","owasp-a01-2021"],"updated":"2026-09-11T20:37:14+00:00","alsoAt":["https://seclists.org/fulldisclosure/2010/Aug/att-236/onsec-whitepaper-01_eng_pdf.bin","http://onsec.ru/onsec-whitepaper-01.eng.pdf"],"sourceKind":"paper"},"a":"archived-references/md/2010/onsec-sdrf-vulnerability-web-applications-browsers-whitepaper.md","b":"archived-references/pdf/2010/onsec-sdrf-vulnerability-web-applications-browsers-whitepaper.pdf","av":"20260911203714","bv":"20260911204747"}],"2010-91":[{"i":"source-fb5996e4e4666c938932","d":{"title":"Are Text-Only Data Formats Safe? Or, Use This LaTeX Class File to Pwn Your Computer (Paper)","updated":"2026-09-29T20:45:32+00:00","sourceKind":"paper"},"m":1,"f":15,"q":238,"av":"20260929204532","bv":"20260929211407"},{"label":"LEET 2010 slides","url":"https://www.usenix.org/legacy/event/leet10/tech/slides/checkoway.pdf","i":"source-19ebe7254a7ebe99a8bd","d":{"title":"Are Text-Only Data Formats Safe? (Slides)","summary":"Presents the LEET 2010 study of malicious TeX documents and online previewers. Examples show why blocking shell commands or filtering literal control sequences does not contain a language with file access and programmable syntax. The deck contrasts vulnerable services with interpreter and process isolation.","updated":"2026-09-29T20:45:44+00:00","sourceKind":"slides","context":"Organizer-hosted presentation of the paper, with the same three-author byline."},"q":174,"a":"archived-references/md/2010/usenix-text-only-data-formats-safe-slides.md","b":"archived-references/pdf/2010/usenix-text-only-data-formats-safe-slides.pdf","av":"20260929204544","bv":"20260929211408"}]}}
