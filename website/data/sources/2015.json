5:28+00:00","sourceKind":"article"},"m":1,"f":15,"q":233,"av":"20260814210528","bv":"20260809085925"},{"label":"Follow-up recording","url":"https://www.youtube.com/watch?v=vzp7JdezZRU","i":"source-ce1cdaf8ba29208854c4","d":{"title":"Timing Attacks Have Never Been So Practical: Advanced Cross-Site Search Attacks","publisher":"Black Hat","published":"2016-11-22","relationship":"follow-up","sourceKind":"video","preservation":"link-only","context":"follow-up: The 2016 Advanced Cross-Site Search talk explicitly compares its new browser-based and second-order developments against Gelernter and Herzberg CCS 2015 original XS-Search. It is an extension, not a recording of that 2015 paper."},"a":"","b":""}],"2015-54":[{"i":"source-14d41922d0e588a9e217","d":{"updated":"2026-08-11T17:35:27+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811173527","bv":"20260808235806"}],"2015-55":[{"i":"source-9e13e106a8c9c0ab47b7","d":{"updated":"2026-08-11T17:43:03+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811174303","bv":"20260808235810"}],"2015-56":[{"i":"source-eef8b7e6359aa6f53a87","d":{"updated":"2026-08-09T08:57:48+00:00","sourceKind":"article"},"m":1,"f":15,"q":233,"av":"20260809085748","bv":"20260809085920"},{"label":"PDF","url":"https://tom.vg/papers/timing-attacks_ccs2015.pdf","i":"source-f8fa400dc351b5bfe8bb","d":{"title":"The Clock is Still Ticking: Timing Attacks in the Modern Web (PDF)","kind":"whitepaper","summary":"Modern browser APIs such as video and script parsing, Application Cache, Service Workers and the Cache API expose timing side channels that reveal a cross-origin response size without measuring network download time. An attacker page can size resources reliably even on mobile links and infer a victim logged-in state, age, gender, location, contacts and search history.","tags":["timing-attack","xsleak","side-channel","info-leak","service-worker","cache","same-origin-policy","javascript","owasp-a01-2021"],"updated":"2026-08-14T22:46:07