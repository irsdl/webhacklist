blisher":"OWASP AppSec Europe","kind":"slides","authors":["James Kettle"],"summary":"Explains how proxy plugins can support manual web security testing by detecting suspicious behavior and vulnerability prerequisites. The slides cover host-header issues, DNS rebinding and relative path overwrite, then discuss generic injection probes and comparison of changing responses.","tags":["header-injection","dns-rebinding","css-injection","fuzzing","detection","owasp-a03-2021","owasp-a09-2021","owasp-a10-2021"],"updated":"2026-09-16T13:47:13+00:00","published":"2014","relationship":"follow-up","sourceKind":"slides","context":"The original deck explicitly discusses automating detection of this research."},"a":"archived-references/md/2013/owasp-appsec-europe-activescan-augmenting-manual-testing-attack-proxy-slides.md","b":"archived-references/pdf/2013/owasp-appsec-europe-activescan-augmenting-manual-testing-attack-proxy-slides.pdf","av":"20260916134713","bv":"20260916135420"}],"2015-36":[{"i":"source-e6d5ea3630b7ed486b4b","d":{"updated":"2026-08-11T17:35:58+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260811173558","bv":"20260806080857"}],"2015-37":[{"i":"source-2d3d815b791c77a9bbc4","d":{"title":"Server-Side Template Injection","updated":"2026-08-11T17:34:11+00:00","alsoAt":["https://portswigger.net/knowledgebase/papers/serversidetemplateinjection.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":238,"av":"20260811173411","bv":"20260810034955"},{"label":"Research wordlist","url":"https://github.com/danielmiessler/SecLists/blob/25d4ac447efb9e50b640649f1a09023e280e5c9c/Discovery/Web-Content/burp-parameter-names.txt","i":"source-d59e0cb7af0b89a58fa6","d":{"title":"Template variable-name wordlist","sourceKind":"dataset","preservation":"link-only","context":"A companion dataset linked by the original source."},"a":"","b":""},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=3cT0uE7Y87s","i":"source-92cf7144933e78d63b3f","d":{"title":"Server-Side Template Injection: RCE For The Modern Web App","published":"2015-12-27","sourceKind":"video","preservation":"link-only","channel":"Black Hat","minutes":45},"a":"","b":""}],"2015-38":[{"i":"source-c47c6b131b3a7de6e604","d":{"title":"Hunting asynchronous vulnerabilities","updated":"2026-08-11T17:34:11+00:00","sourceKind":"article"},"m":1,"f":15,"q":238,"av":"20260811173411","bv":"20260815062621"},{"label":"Talk slides","url":"https://portswigger.net/knowledgebase/papers/huntingasynchronousvulnerabilities.pdf","i":"source-b11df7e04ef59967e7b0","d":{"kind":"whitepaper","sourceKind":"slides","context":"A companion slide deck linked by the original source."},"q":1,"a":"","b":""},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=ha6LD1-RiJU","i":"source-9a5e4a192a1b3a1f63a8","d":{"title":"2016 - James Kettle - Hunting Asynchronous Vulnerabilities","published":"2016-09-26","sourceKind":"video","preservation":"link-only","channel":"BSides Manchester","minutes":40},"a":"","b":""}],"2015-39":[{"i":"source-e174cd08af80fc15a22d","d":{"title":"Critical vulnerabilities in JSON Web Token libraries","updated":"2026-08-10T15:07:10+00:00","sourceKind":"article"},"m":1,"f":15,"q":202,"av":"20260810150710","bv":"20260812161053"},{"label":"Original guest publication","url":"https://auth0.com/blog/2015/03/31/critical-vulnerabilities-in-json-web-token-libraries/","i":"source-9fc23fc59734f2396c5d","d":{"title":"Critical vulnerabilities in JSON Web Token libraries","relationship":"alternate","sourceKind":"article","context":"Another edition or presentation of this work."},"q":8,"a":"","b":""}],"2015-40":[{"i":"source-ebf877686838408efb48","d":{"updated":"2026-08-14T21:00:17+00:00","sourceKind":"paper"},"m":1,"f":15,"q":233,"av":"20260814210017","bv":"20260808235807"},{"label":"Talk recording","url":"https://www.youtube.com/watch?v=rELp9-oFAw0","i":"source-082ac369b5f5b7daf812","d":{"published":"2015-09-12","sourceKind":"video","preservation":"link-only","channel":"IEEE Symposium on Security and Privacy","minutes":21},"q":1,"a":"","b":""}],"2015-41":[{"i":"source-616d243ef6c7879465c8","d":{"title":"[1502.07373] The Spy in the Sandbox -- Practical Cache Attacks in Javascript","updated":"2026-08-19T16:44:13+00:00","alsoAt":["https://arxiv.org/pdf/1502.07373"],"sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260819164413","bv":"20260819164414"},{"label":"PDF","url":"https://cs.brown.edu/people/vpk/papers/spy.ccs15.pdf","i":"source-5287558406d7991098ce","d":{"title":"The Spy in the Sandbox: Practical Cache Attacks in JavaScript and their Implications (PDF)","kind":"whitepaper","summary":"A last-level cache PRIME+PROBE side-channel attack written entirely in JavaScript, needing no installed code: the victim only loads a page or an ad. It builds eviction sets without large-page support and uses high-resolution timers to recover memory access patterns, tracking which sites a user visits with over 80% accuracy, across processes, browsers, private browsing and VMs.","tags":["side-channel","timing-attack","info-leak","javascript"],"updated":"2026-08-14T22:46:05+00:00","relationship":"related","sourceKind":"paper"},"q":32,"a":"archived-references/md/2015/spy-sandbox-practical-cache-attacks-javascript-their-implications-pdf.md","b":"archived-references/pdf/2015/spy-sandbox-practical-cache-attacks-javascript-their-implications-pdf.pdf","av":"20260814224605","bv":"20260814224931"}],"2015-42":[{"i":"source-55c30091426e6d22c89c","d":{"title":"[1507.06955] Rowhammer.js: A Remote Software-Induced Fault Attack in JavaScript","updated":"2026-08-19T16:44:08+00:00","alsoAt":["https://arxiv.org/pdf/1507.06955"],"sourceKind":"article"},"m":1,"f":15,"q":250,"av":"20260819164408","bv":"20260819164409"}],"2015-43":[{"i":"source-807c0821eb2729c5b2a9","d":{"updated":"2026-08-19T16:44:37+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity15/sec15-paper-de-ruiter.pdf","https://www.usenix.org/sites/default/files/conference/protected-files/sec15_slides_de-ruiter.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260819164437","bv":"20260819164438"}],"2015-44":[{"i":"source-0b8eb48dd7f49dec301b","d":{"updated":"2026-08-19T16:28:11+00:00","alsoAt":["https://www.ndss-symposium.org/wp-content/uploads/2017/09/01_1_2.pdf","https://www.ndss-symposium.org/wp-content/uploads/2017/09/Identifying.slide_.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260819162811","bv":"20260819162812"}],"2015-45":[{"i":"source-f45f8c0f00f3dc27fff7","d":{"updated":"2026-08-19T16:44:30+00:00","alsoAt":["https://www.usenix.org/system/files/conference/usenixsecurity15/sec15-paper-zheng.pdf"],"sourceKind":"article"},"m":1,"f":15,"q":251,"av":"20260819164430","bv":"20260819164431"}],"2015-46":[{"i":"source-07ecbfc53b9c3ff84862","d":{"updated":"2026-08-12T15:50:00+00:00","sourceKind":"article"},"m":1,"f":15,"q":233,"av":"20260812155000","bv":"20260815062629"},{"label":"PDF","url":"https://www.cs.utexas.edu/~isil/ccs15.pdf","i":"source-a7bc9ed85c783168e678","d":{"title":"Detecting and Exploiting Second Order Denial-of-Service Vulnerabilities in Web Applications (PDF)","kind":"whitepaper","summary":"A second-order denial of service pollutes a database with junk rows in one phase, then triggers an unbounded computation over those rows in a later request, exhausting server CPU from a low-bandwidth attacker. The Torpedo static analysis finds this pattern in PHP applications and symbolically generates attack vectors, uncovering 37 vulnerabilities across six widely used applications.","updated":"2026-08-14T22:46:06+00:00","relationship":"related","sourceKind":"paper"},"q":160,"a":"archived-references/md/2015/detecting-exploiting-second-order-denial-service-vulnerabilities-web-pdf.md","b":"archived-references/pdf/2015/detecting-exploiting-second-order-denial-service-vulnerabilities-web-pdf.pdf","av":"20260814224606","bv":"20260814224931"}],"2015-47":[{"i":"source-9a3f365c6ba26c3c82a6","d":{"updated":"2026-08-10T23:08:19+00:00","sou