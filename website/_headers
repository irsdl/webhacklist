# THE ONE THIRD-PARTY FRAME. `frame-src` names youtube-nocookie.com so a talk can
# play inside the record instead of throwing the reader out to another tab. It
# widens nothing else: the player runs in YouTube's origin under its own policy,
# `script-src` stays 'self', and `img-src` is deliberately NOT widened - the
# player is reached through a locally drawn facade, so no request leaves the page
# for a reader who never presses play. `fullscreen=(self ...)` below is the same
# grant for the player's fullscreen button; without it the control is inert.
#
# Cloudflare Pages APPENDS the headers of every rule that matches a request
# rather than letting the most specific rule win. A Cache-Control here would
# therefore be prepended to each per-path value below, and browsers take the
# first max-age they see, so max-age=0 would silently defeat the immutable and
# stale-while-revalidate policies. Security headers apply to everything and are
# safe to repeat; caching is set per path instead.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self' https://irsdl.github.io https://www.youtube-nocookie.com; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; media-src 'none'; worker-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self "https://www.youtube-nocookie.com")

# The app shell and the catalogue index revalidate on every load so a new
# deployment is picked up immediately. Each path needs its own block: the
# _headers format has no way to share one block between several paths.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/discovery.js
  Cache-Control: public, max-age=0, must-revalidate

/discovery.css
  Cache-Control: public, max-age=0, must-revalidate

/constellation.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/pdf-reader.html
  Cache-Control: public, max-age=0, must-revalidate

/pdf-reader.css
  Cache-Control: public, max-age=0, must-revalidate

/pdf-reader.mjs
  Cache-Control: public, max-age=0, must-revalidate

/pdf-reader-url.mjs
  Cache-Control: public, max-age=0, must-revalidate

/pdf-reader-polyfills.mjs
  Cache-Control: public, max-age=0, must-revalidate

/pdf-worker.mjs
  Cache-Control: public, max-age=0, must-revalidate

/vendor/pdfjs/*
  Cache-Control: public, max-age=31536000, immutable

/brand-mark.svg
  Cache-Control: public, max-age=0, must-revalidate

/social-preview.png
  Cache-Control: public, max-age=0, must-revalidate
  ! Cross-Origin-Resource-Policy
  Access-Control-Allow-Origin: *

/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/data/catalogue.json
  Cache-Control: public, max-age=0, must-revalidate

# Shards are requested with their own content version from the catalogue.
# Unchanged collections keep their URL across unrelated archive updates. A
# year of immutable caching is safe for each versioned URL.
/data/collections/*
  Cache-Control: public, max-age=31536000, immutable

/data/sources/*
  Cache-Control: public, max-age=31536000, immutable

# PRESERVED COPIES OF OTHER PEOPLE'S WORK, kept out of the index on purpose.
# These files are the researcher's article, not this archive's writing. Letting
# a search engine index them would put this domain into results for work
# somebody else published, competing with their own page for their own words.
# `noindex` costs a reader nothing - the files stay public, linkable and
# readable - and the catalogue record generated for each one (/reference/...)
# is what carries the archive's own summary into search instead.
/archived-references/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex

/original-listings/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex

# Generated crawlable pages (see build-pages.mjs). They are rebuilt on every
# deploy from the catalogue, so they revalidate like the app shell rather than
# being cached against a version string.
/pages.css
  Cache-Control: public, max-age=0, must-revalidate

/research/*
  Cache-Control: public, max-age=0, must-revalidate

/reference/*
  Cache-Control: public, max-age=0, must-revalidate

/security/*
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/security.txt
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8
