# Python bytecode and test caches from local runs
__pycache__/
*.pyc
.pytest_cache/
NUL
dist/
_site/
.tmp/
# Rebuilt from tracked year lists, manifest, and source groups by both hosts.
website/data/

# Private scoring notes and calibration results; publish decisions only.
.local/ai-evaluation/
.local/related-sources/
.local/security-hardening/
.local/attribution/

.vscvode/

# Workspace copy of the reference content store. The durable store lives at
